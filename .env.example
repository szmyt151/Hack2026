# Wspólne ustawienia Docker Compose. Skopiuj jako .env i uzupełnij wartości.
OPENAI_API_KEY=
BROKER_URL=ws://broker:8080

# Brain -> Virtuoso: wymagane, aby delegacje korzystały z wiedzy i MCP tools Virtuoso.
VIRTUOSO_API_URL=
VIRTUOSO_API_TOKEN=
VIRTUOSO_MODEL=

# Voice Core
AUDIO_SAMPLE_RATE=16000
WAKE_WORD=Asystencie
ASSISTANT_NAME=Asystent
VOICE=marin
LANGUAGE=pl

# Meeting runner (używane wyłącznie przez profil Compose `meeting`)
MEETING_URL=
ASSISTANT_DISPLAY_NAME=Asystent
HEADLESS=false
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=100
