OPENAI_API_KEY=

# WebSocket hub zespołu (meeting-runner/scripts/mock-broker.ts lub docelowy hub)
BROKER_URL=ws://localhost:8080

# Musi zgadzać się z AUDIO_IN_SAMPLE_RATE i AUDIO_OUT_SAMPLE_RATE w meeting-runner.
# gpt-live-1 obsługuje 16000 lub 24000; jeden format dla in i out.
AUDIO_SAMPLE_RATE=16000

# Jak asystent ma być wołany w spotkaniu
WAKE_WORD=Asystencie
ASSISTANT_NAME=Asystent
VOICE=marin
LANGUAGE=pl

# Ile sekund transkryptu wysyłać do C jako "request" przy delegacji
DELEGATION_REQUEST_WINDOW_S=20
# Ile sekund transkryptu wysyłać jako szerszy kontekst
DELEGATION_CONTEXT_WINDOW_S=180
