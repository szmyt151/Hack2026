OPENAI_API_KEY=
BROKER_URL=ws://localhost:8080

# Twój istniejący agent z MCP. Brain woła POST $AGENT_URL z {prompt, context}.
# Puste = tryb mock (odpowiada stałym tekstem) — do testów bez agenta.
AGENT_URL=
AGENT_API_KEY=

# Modele
VISION_MODEL=gpt-5.6-luna
NOTES_MODEL=gpt-5.6-luna

# Profil usera wstrzykiwany do agenta i do gpt-live-1 jako kontekst
USER_PROFILE_FILE=./user-profile.md

# Notatki co N sekund
NOTES_INTERVAL_S=60

# Panel demo
PANEL_PORT=3000
