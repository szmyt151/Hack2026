# Link do spotkania Teams (https://teams.microsoft.com/l/meetup-join/...)
MEETING_URL=

# WebSocket hub zespołu (na start: mock broker z `npm run mock-broker`)
BROKER_URL=ws://localhost:8080

# Nazwa, pod którą asystent przedstawia się w spotkaniu (jeśli join jest anonimowy)
ASSISTANT_DISPLAY_NAME=Asystent Adriana

# Katalog z profilem Chromium zalogowanym na konto usera (tworzony przez `npm run login`)
USER_DATA_DIR=./.chromium-profile

# false = widzisz okno przeglądarki (zalecane pod xvfb), true = headless
HEADLESS=false

# Audio (PulseAudio)
PULSE_SINK_MEETING=meeting_out
PULSE_SINK_ASSISTANT=assistant_mic
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=100

# Screenshoty
SCREEN_INTERVAL_MS=3000
SCREEN_DIFF_THRESHOLD=0.02

# Reconnect po rozłączeniu (opóźnienie rośnie liniowo z numerem próby)
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=5000
