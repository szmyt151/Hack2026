{
  "name": "teams-meeting-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "tsx scripts/login.ts",
    "start": "tsx src/index.ts",
    "start:xvfb": "xvfb-run -a --server-args='-screen 0 1280x720x24' tsx src/index.ts",
    "mock-broker": "tsx scripts/mock-broker.ts",
    "audio:setup": "bash scripts/setup-audio.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
